# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://pod:pod@localhost:5432/pod?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# AI provider: mock (safe manual-review default) | anthropic | gemini
AI_PROVIDER="mock"
# Optional deterministic test/demo fixture: verified | missing-stamp | missing-signature | low-confidence | shortage
MOCK_AI_FIXTURE=""
ANTHROPIC_API_KEY=""
# Server-only Gemini API key; required only when AI_PROVIDER=gemini
GEMINI_API_KEY=""
# Optional Gemini model override
GEMINI_MODEL="gemini-2.5-flash"
# Company name exactly as in Tally (used in the XML import)
TALLY_COMPANY="Company A"
